# Copy to deploy/.env and fill in. Never commit the real file (.env is git-ignored).
# Generate passwords and keys on the server, e.g.:   openssl rand -hex 24      (hex avoids characters that break database URLs)
SITE_ADDRESS=hos.example.com
# The address people type in the browser, as the browser sends it (default: https://SITE_ADDRESS). Only set it when something sits in front, e.g. a tunnel or another proxy.
# ALLOWED_ORIGINS=https://hos.example.com
POSTGRES_PASSWORD=
HOS_OWNER_PASSWORD=
HOS_APP_PASSWORD=
HOS_ADMIN_PASSWORD=
# 32 random bytes, base64:   openssl rand -base64 32     KEEP A COPY somewhere safe: without it, stored second-factor secrets cannot be read.
APP_ENCRYPTION_KEY=
MFA_ISSUER=Sunset Hospitality
# A hosted TEST copy (for a partner to try the system): set HOS_TEST_COPY=1 and choose DEMO_PASSWORD (12+ characters, shared by the demo users). Leave both empty for a real business.
# Never put real guest data on a test copy.
HOS_TEST_COPY=0
DEMO_PASSWORD=
# Email through Amazon SES (leave MAIL_FROM empty to keep email off). The sender must be verified in SES, and SES must be out of the sandbox to reach guests.
# Lightsail servers cannot take an IAM role: make an IAM user allowed only ses:SendEmail and put its keys here. Never commit this file.
MAIL_FROM=guestcare@sunsetbb.com
MAIL_REPLY_TO=guestcare@sunsetbb.com
SES_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Bounce and spam-complaint handling: the SNS topic SES publishes to (see docs/hosting.md). Leave empty to ignore feedback.
SES_SNS_TOPIC_ARN=
