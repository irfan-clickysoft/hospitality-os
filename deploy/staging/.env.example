# Copy to /opt/hospitality/.env on the staging server. NEVER commit the real file. Generate secrets with: openssl rand -hex 24
HOS_REGISTRY=ghcr.io/irfan-clickysoft
HOS_TAG=latest
HOS_DB=hos_staging
PUBLIC_WEB_ORIGIN=https://pms-s.sunsetbb.com
PG_SUPERUSER_PASSWORD=
HOS_OWNER_PASSWORD=
HOS_APP_PASSWORD=
HOS_ADMIN_PASSWORD=
# 32 random bytes, base64:  openssl rand -base64 32
APP_ENCRYPTION_KEY=
# Only for the one-off demo seed:
DEMO_PASSWORD=
SEED_OWNER_EMAIL=owner@sunset.local

# Email through Amazon SES (optional). Verify the sender in SES first; keep the keys out of git and chat.
MAIL_FROM=
MAIL_REPLY_TO=
SES_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
