{
  "name": "hospitality-os",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "engines": { "node": ">=22" },
  "scripts": {
    "start": "bash scripts/start-local.sh",
    "build": "turbo run build",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "db:bootstrap": "bash scripts/bootstrap-db.sh",
    "db:migrate": "pnpm --filter @hos/db migrate"
  },
  "devDependencies": {
    "turbo": "^2.5.0",
    "typescript": "^5.8.0",
    "@types/node": "^22.0.0",
    "vitest": "^3.2.0",
    "tsx": "^4.19.0"
  }
}
