{
  "name": "@hos/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/main.js",
    "dev": "tsx watch --env-file=../../.env src/main.ts",
    "test": "vitest run",
    "seed:sunset": "tsx --env-file=../../.env src/cli/seed-sunset.ts",
    "seed:sunset-rates": "tsx --env-file=../../.env src/cli/seed-sunset-rates.ts",
    "seed:sunset-accounts": "tsx --env-file=../../.env src/cli/seed-sunset-accounts.ts",
    "seed:sunset-tax": "tsx --env-file=../../.env src/cli/seed-sunset-tax.ts",
    "seed:demo-staff": "tsx --env-file=../../.env src/cli/seed-demo-staff.ts",
    "roles:sync": "tsx --env-file=../../.env src/cli/sync-roles.ts"
  },
  "dependencies": {
    "@fastify/multipart": "^9.4.0",
    "@hos/auth": "workspace:*",
    "@hos/db": "workspace:*",
    "@hos/domain-types": "workspace:*",
    "@hos/rates": "workspace:*",
    "@nestjs/common": "^11.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/platform-fastify": "^11.0.0",
    "@node-rs/argon2": "^2.2.2",
    "fastify": "^5.0.0",
    "kysely": "^0.28.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@nestjs/testing": "^11.2.7"
  }
}