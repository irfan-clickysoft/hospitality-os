# Local development only. Copy to .env (git-ignored). Never commit real credentials.
DATABASE_URL_OWNER=postgres://hos_owner:dev@localhost:5432/hos_dev
DATABASE_URL_APP=postgres://hos_app:dev@localhost:5432/hos_dev
DATABASE_URL_ADMIN=postgres://hos_admin:dev@localhost:5432/hos_dev
# 32 random bytes, base64:  node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
APP_ENCRYPTION_KEY=CHANGE_ME
ALLOWED_ORIGINS=http://localhost:3001
# Plain-http local development only (the app refuses to start with this when NODE_ENV=production)
COOKIE_INSECURE_DEV=1
PORT=3000
# Host port of the dev database container; change it (and the three URLs above) if 5432 is already in use
HOS_DB_PORT=5432
# Email (Amazon SES). Leave MAIL_FROM empty to switch email sending off; staff can still copy the message.
# MAIL_FROM must be an address or domain verified in SES. In production give the server an IAM role (or these keys) allowed to ses:SendEmail.
MAIL_FROM=
MAIL_REPLY_TO=
SES_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
